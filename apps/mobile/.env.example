EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Dashboard > Settings > API Keys > Publishable key. Starts with
# sb_publishable_. Never the secret key: it bypasses RLS and the app bundle is
# readable. The Edge Functions receive their own key from the platform, so
# there is nothing server-side to paste here.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Public invitation links resolve here. Use the deployed universal-link origin in release builds.
EXPO_PUBLIC_PUBLIC_APP_URL=https://davetim.app

# Keep writes and live rewarded ads disabled until staging RLS/server-verification checks pass.
EXPO_PUBLIC_ENABLE_BACKEND_WRITES=false
EXPO_PUBLIC_ENABLE_REWARDED_ADS=false

# AdMob native App IDs are private build-time values. Rewarded unit IDs are public client configuration.
# Production config fails closed when ads are enabled without both native App IDs.
ADMOB_ANDROID_APP_ID=
ADMOB_IOS_APP_ID=
EXPO_PUBLIC_ADMOB_REWARDED_ANDROID_UNIT_ID=
EXPO_PUBLIC_ADMOB_REWARDED_IOS_UNIT_ID=

# Store URLs are intentionally empty until the listings are live.
EXPO_PUBLIC_APP_STORE_URL=
EXPO_PUBLIC_PLAY_STORE_URL=
